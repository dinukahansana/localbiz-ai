{
  "name": "localbiz-ai",
  "private": true,
  "version": "0.1.0",
  "description": "LocalBiz AI — LovHack Season 3, AI campaign workspace",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n server,client -c green,cyan \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "build:production": "node scripts/build-production.js",
    "preview": "npm run preview --workspace client",
    "start": "npm run start --workspace server",
    "lint": "eslint .",
    "test": "npm run test --workspace server",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.6.2"
  }
}
