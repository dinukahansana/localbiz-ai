NODE_ENV=development
# Use production behind HTTPS: authentication cookies then require HTTPS.
HOST=localhost
PORT=5000
# Comma-separated browser origins. Add your deployed frontend origin later.
CLIENT_URL=http://localhost:5173,http://localhost:4173
# Required to save profiles/products/campaigns. A blank URI still allows the API health check.
MONGODB_URI=
# Atlas example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/localbiz_ai?retryWrites=true&w=majority
# Local MongoDB example: mongodb://127.0.0.1:27017/localbiz_ai
# Store real credentials only in server/.env, never in client/.
# Gemini key from Google AI Studio; blank disables generation but saved drafts still work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
