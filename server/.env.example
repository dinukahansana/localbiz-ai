NODE_ENV=development
HOST=localhost
PORT=5000
# Comma-separated browser origins. Add your deployed frontend origin later.
CLIENT_URL=http://localhost:5173,http://localhost:4173
# Optional for Phase 1. Leave blank to run without a database.
MONGODB_URI=
# Local MongoDB example: mongodb://127.0.0.1:27017/localbiz_ai
# Store real credentials only in server/.env, never in client/.
