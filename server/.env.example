NODE_ENV=development
# Use production behind HTTPS: authentication cookies then require HTTPS.
HOST=localhost
# Production hosting: use HOST=0.0.0.0 and TRUST_PROXY_HOPS=1 for Render's nearest proxy.
# Do not trust an arbitrary forwarded chain.
TRUST_PROXY_HOPS=0
PORT=5000
# Comma-separated browser origins. Add your deployed frontend origin later.
CLIENT_URL=http://localhost:5173,http://localhost:4173
# Production requires your exact HTTPS Vercel origin, without a trailing slash/path.
# Required to save profiles/products/campaigns. A blank URI still allows the API health check.
MONGODB_URI=
# Atlas: paste the Node.js Drivers URI here in server/.env; set the database name to localbiz_ai.
# Local MongoDB example: mongodb://127.0.0.1:27017/localbiz_ai
# Store real credentials only in server/.env, never in client/.
# Gemini key from Google AI Studio; blank disables generation but saved drafts still work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# AI promotion posters: create a key in deAPI Dashboard > Settings > API Keys.
# Blank disables AI generation; the free browser photo template still works.
DEAPI_API_KEY=
# Exact native-model quote ceiling in deAPI credits per generated image.
DEAPI_MAX_PRICE=0.05
# Shared app limit per UTC day (all accounts); each account also has five per UTC hour.
DEAPI_DAILY_LIMIT=20
